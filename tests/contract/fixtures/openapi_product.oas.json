{
  "openapi": "3.1.2",
  "info": {"title": "Owned offline product API", "version": "1"},
  "servers": [{"url": "/api"}],
  "paths": {
    "/ping": {
      "get": {
        "operationId": "Ping",
        "parameters": [{"in": "query", "name": "limit", "required": true,
          "schema": {"type": "integer", "default": 4}}],
        "responses": {"200": {"description": "Owned metadata only"}}
      }
    },
    "/notes": {
      "post": {
        "operationId": "AddNote",
        "requestBody": {"required": true, "content": {"application/json": {
          "schema": {"type": "object", "required": ["text"], "properties": {
            "text": {"type": "string", "default": "owned-original-only-marker"}
          }}
        }}},
        "responses": {"200": {"description": "Owned metadata only"}}
      }
    }
  }
}
