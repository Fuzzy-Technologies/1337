        "/branch-a": {
          "anchor_count": 5,
          "entries": [{"path": "/branch-b", "ordinals": [5]},
            {"path": "/fixed/.git/HEAD", "ordinals": [3]},
            {"path": "/html/.git/HEAD", "ordinals": [4]},
            {"path": "/leaf/.git/HEAD", "ordinals": [2]},
            {"path": "/shared", "ordinals": [1]}],
          "exclusion_counts": {"missing-href": 0, "invalid-url": 0, "fragment-only": 0,
            "non-http": 0, "credentials": 0, "query": 0, "off-origin": 0,
            "unsupported-path": 0, "source-target": 0, "not-admitted": 0}
        },
        "/branch-b": {
          "anchor_count": 3,
          "entries": [{"path": "/entry", "ordinals": [3]},
            {"path": "/leaf/.git/HEAD", "ordinals": [2]},
            {"path": "/shared", "ordinals": [1]}],
          "exclusion_counts": {"missing-href": 0, "invalid-url": 0, "fragment-only": 0,
            "non-http": 0, "credentials": 0, "query": 0, "off-origin": 0,
            "unsupported-path": 0, "source-target": 0, "not-admitted": 0}
        },
        "/shared": {
          "anchor_count": 2,
          "entries": [{"path": "/branch-a", "ordinals": [1]},
            {"path": "/leaf/.git/HEAD", "ordinals": [2]}],
          "exclusion_counts": {"missing-href": 0, "invalid-url": 0, "fragment-only": 0,
            "non-http": 0, "credentials": 0, "query": 0, "off-origin": 0,
            "unsupported-path": 0, "source-target": 0, "not-admitted": 0}
        }
      },
      "inverted_completion": {"required_before_b_completion": ["/branch-a", "/branch-b"],
        "completed_before": ["/branch-b", "/branch-a"], "minimum_overlap": 2,
        "minimum_overlap_counter": "maximum_active_handlers"}
    },
    "fixed": {"expected_completed": true, "expected_waves": [["/entry"]],
      "expected_commit_order": ["/entry"], "seed_anchor_count": 0},
    "decoy": {"expected_completed": true, "expected_waves": [["/entry"]],
      "expected_commit_order": ["/entry"], "seed_anchor_count": 0},
    "redirect": {"expected_completed": false, "expected_waves": [["/entry"], ["/redirect"]],
      "expected_commit_order": ["/entry"], "seed_anchor_count": 1,
      "expected_failure": "response-policy", "redirect_followup_contacts": 0}
  },
  "leaf_responses": {
    "/leaf/.git/HEAD": {"status": 200, "media_type": "text/plain", "outcome": "non-html",
      "body": "ref: refs/heads/independent-crawl-fixture\n"},
    "/fixed/.git/HEAD": {"status": 403, "media_type": "text/plain", "outcome": "client-error",
      "body": "owned-dotfile-denied"},
    "/html/.git/HEAD": {"status": 200, "media_type": "text/html", "outcome": "html",
      "body": "<html><body><code>ref: refs/heads/independent-crawl-fixture\n</code></body></html>"},
    "/redirect": {"status": 302, "media_type": "text/plain", "outcome": "refused",
      "body": "owned-crawl-redirect", "location": "/redirect-destination"}
  },
  "git_handoff": {
    "policy": {"impact": "STANDARD", "capability": "web.git-head-check",
      "requires_separate_permission": true, "requires_exact_plan_confirmation": true},
    "endpoint_identity": {"crawl": "structural-json-key", "git": "legacy-exact-url",
      "automatic_join": false},
    "cases": [
      {"id": "crawl-git-positive", "path": "/leaf/.git/HEAD", "discovered_in": "positive",
        "capability": "fuzzy1337-git-head-exposure", "expected_match": true},
      {"id": "crawl-git-fixed", "path": "/fixed/.git/HEAD", "discovered_in": "positive",
        "capability": "fuzzy1337-git-head-exposure", "expected_match": false},
      {"id": "crawl-git-html-decoy", "path": "/html/.git/HEAD", "discovered_in": "positive",
        "capability": "fuzzy1337-git-head-exposure", "expected_match": false},
      {"id": "crawl-git-redirect", "path": "/redirect", "discovered_in": "redirect",
        "capability": "fuzzy1337-git-head-exposure", "expected_match": false}
    ],
    "expected_metrics": {"tp": 1, "tn": 3, "fp": 0, "fn": 0},
    "failed_or_unexecuted_work_counts_as_negative": false,
    "persistence_requirements": ["original-stdout-stderr-and-invocation", "saved-findings",
      "operator-triage-preserved-on-rerun", "workspace-reopen", "capability-metadata"]
  },
  "cancellation_peer_observation": {
    "accepted_terminal_kinds": ["eof", "peer-reset"],
    "peer_closed_means": "original-eof-only",
    "requires_original_peer_receive": true,
    "requires_before_local_close": true,
    "requires_within_original_hold": true,
    "known_reset_codes": {"posix": "ECONNRESET", "windows": 10054},
    "refused_kinds": ["timeout", "os-error", "unexpected-data", "local-teardown",
      "before-peer-receive", "unobserved"],
    "original_hold_seconds": 3,
    "requires_original_sdk_execution_control_and_no_model_save": true
  },
  "acceptance_required": [
    "installed-packaged-worker", "genuine-sdk", "installed-cli", "same-seed-byte-mutation",
    "exact-original-requests-and-served-bytes", "ordered-model-saves", "original-worker-evidence",
