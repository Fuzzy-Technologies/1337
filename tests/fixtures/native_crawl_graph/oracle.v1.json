      "expected_commit_order": ["/entry", "/branch-a", "/branch-b", "/fixed/.git/HEAD",
        "/html/.git/HEAD", "/leaf/.git/HEAD", "/shared"],
      "expected_frontiers": {
        "/entry": {
          "anchor_count": 13,
          "entries": [{"path": "/branch-a", "ordinals": [2, 3]},
            {"path": "/branch-b", "ordinals": [1]}],
          "exclusion_counts": {"missing-href": 1, "invalid-url": 0, "fragment-only": 1,
            "non-http": 1, "credentials": 1, "query": 1, "off-origin": 1,
            "unsupported-path": 1, "source-target": 1, "not-admitted": 2}
