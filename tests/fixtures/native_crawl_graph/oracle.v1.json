  "zero_contact_paths": [
    "/comment-decoy", "/script-decoy", "/style-decoy", "/selected-unreachable",
    "/unselected", "/unregistered", "/credential-marker", "/query-marker?private-marker=1",
    "/off-origin-marker", "/bad%20path", "/redirect-destination"
  ],
  "transient_markers": [
    "credential-marker", "private-marker", "fragment-marker", "off-origin-marker",
    "non-http-marker", "/bad%20path", "/unselected", "/unregistered"
  ],
  "configuration": {
    "literal_address": "127.0.0.1",
    "method": "GET",
    "maximum_selected_urls": 16,
    "owned_origins": 2,
    "selected_origins": 1,
    "sentinel_in_main_selection": false,
    "aggregate_maximum_handlers": 8,
    "aggregate_maximum_detailed_contacts": 128,
    "aggregate_cleanup_deadline_seconds": 6,
    "maximum_retained_contacts": 64,
    "maximum_dispatched_contacts": 64,
    "maximum_error_details": 64,
    "maximum_concurrency": 4,
    "request_limit_bytes": 8192,
    "socket_timeout_seconds": 2,
    "request_whole_deadline_seconds": 2,
    "response_gate_seconds": 2,
    "cleanup_whole_deadline_seconds": 3,
    "remote_control_routes": [],
    "outbound_requests": 0,
    "file_writes": 0,
    "authentication": false
  },
  "sentinel_oracle": {
    "origin": "second-fixture-owned-ephemeral-literal-loopback",
    "href_path": "/off-origin-marker",
    "required_original_contacts_after_both_owner_cleanup": 0,
    "terminal_status": 404,
    "terminal_body": "owned-off-origin-contact-must-be-zero",
    "zero_contact_uses_own_accept_time_ledger": true
  },
  "contact_accounting": {
    "starts_at": "original-socket-accept",
    "includes": ["empty", "partial", "invalid", "refused", "late-during-close", "completed"],
    "exact_totals": "state.Counters",
    "bounded_details": "state.Observe and state.Errors",
    "overflow_explicit": true,
    "zero_contact_requires": {"contacts": 0, "retained_contacts": 0, "contact_overflow": 0},
    "original_prefix_truncation_explicit": true,
    "teardown_erases_no_contact_or_failure": true,
    "idle_requires": ["original-sockets", "running-handlers", "released-dispatch-slots"],
    "idle_wait": "one-bounded-event-wait-with-atomic-owner-recheck"
  },
  "variants": {
    "positive": {
      "expected_completed": true,
      "expected_waves": [["/entry"], ["/branch-a", "/branch-b"],
