{
  "schema_version": 1,
  "target_pack": "first-party.native-crawl-graph",
  "target_version": "1",
  "provenance": "repository-owned-handwritten-source-and-truth",
  "profile": "owned-loopback-content-crawl.v1",
  "capabilities": ["http.owned-loopback-crawl", "fuzzy1337-git-head-exposure"],
  "seed_path": "/entry",
  "selected_paths": [
    "/branch-a", "/branch-b", "/comment-decoy", "/entry", "/fixed/.git/HEAD",
    "/html/.git/HEAD", "/leaf/.git/HEAD", "/redirect", "/redirect-destination",
    "/script-decoy", "/selected-unreachable", "/shared", "/style-decoy"
