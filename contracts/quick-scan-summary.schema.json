{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuzzy-technologies.github.io/1337/contracts/quick-scan-summary.schema.json",
  "title": "1337 Experimental Quick Scan summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow", "state", "capabilities", "started_at", "finished_at", "duration_seconds", "first_model_update_seconds", "first_update_budget_seconds", "model_revision", "object_counts", "job", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "workflow": {"const": "quick"},
    "state": {"enum": ["completed", "failed", "cancelled"]},
    "capabilities": {"const": ["http.endpoint-discovery"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "duration_seconds": {"type": "number", "minimum": 0},
    "first_model_update_seconds": {"type": ["number", "null"], "minimum": 0},
    "first_update_budget_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
    "model_revision": {"type": "integer", "minimum": 0},
    "object_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace", "scope", "target", "domain", "host", "asset", "port", "service", "endpoint", "technology"],
      "properties": {
        "workspace": {"$ref": "#/$defs/count"}, "scope": {"$ref": "#/$defs/count"},
        "target": {"$ref": "#/$defs/count"}, "domain": {"$ref": "#/$defs/count"},
        "host": {"$ref": "#/$defs/count"}, "asset": {"$ref": "#/$defs/count"},
        "port": {"$ref": "#/$defs/count"}, "service": {"$ref": "#/$defs/count"},
        "endpoint": {"$ref": "#/$defs/count"}, "technology": {"$ref": "#/$defs/count"}
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "state", "last_sequence", "progress", "failure", "artifacts", "cancellation_requested", "schema_version"],
      "properties": {
        "schema_version": {"const": 1}, "spec": {"type": "object"},
        "state": {"enum": ["completed", "failed", "cancelled"]},
        "last_sequence": {"$ref": "#/$defs/count"},
        "progress": {"type": ["object", "null"]}, "failure": {"type": ["object", "null"]},
        "artifacts": {"type": "array", "items": {"type": "object"}},
        "cancellation_requested": {"type": "boolean"}
      }
    },
    "events": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "job_id", "sequence", "kind", "data"],
      "properties": {
        "schema_version": {"const": 1}, "job_id": {"type": "string", "minLength": 1},
        "sequence": {"$ref": "#/$defs/count"},
        "kind": {"enum": ["state", "progress", "heartbeat", "cancellation_requested", "observation", "artifact", "model_delta", "failure"]},
        "data": {}
      }
    }
  }
}
