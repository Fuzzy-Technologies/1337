{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fuzzy-technologies.github.io/1337/contracts/external-target.v1",
  "title": "Pinned optional external regression target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "identifier", "version", "repository", "tag", "index_digest",
    "platform_digests", "source_revision", "release_url", "registry_url", "resolved_at",
    "compose_service", "compose_profile", "http_port", "resource_limits",
    "budgets_seconds", "oracle_complete"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "identifier": {"const": "juice-shop"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "repository": {"const": "bkimminich/juice-shop"},
    "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "index_digest": {"$ref": "#/$defs/digest"},
    "platform_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux/amd64", "linux/arm64"],
      "properties": {
        "linux/amd64": {"$ref": "#/$defs/digest"},
        "linux/arm64": {"$ref": "#/$defs/digest"}
      }
    },
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "release_url": {
      "type": "string",
      "pattern": "^https://github\\.com/juice-shop/juice-shop/releases/tag/v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "registry_url": {
      "type": "string",
      "pattern": "^https://hub\\.docker\\.com/v2/repositories/bkimminich/juice-shop/tags/v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "resolved_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "compose_service": {"const": "external-juice-shop"},
    "compose_profile": {"const": "external-juice-shop"},
    "http_port": {"const": 3000},
    "resource_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["memory_mib", "cpus", "pids"],
      "properties": {
        "memory_mib": {"type": "integer", "minimum": 256, "maximum": 2048},
        "cpus": {"type": "number", "minimum": 0.1, "maximum": 2},
        "pids": {"type": "integer", "minimum": 16, "maximum": 256}
      }
    },
    "budgets_seconds": {
      "type": "object", "additionalProperties": false,
      "required": ["pull", "startup", "health", "request", "command", "cleanup"],
      "properties": {
        "pull": {"type": "integer", "minimum": 1, "maximum": 300},
        "startup": {"type": "integer", "minimum": 1, "maximum": 180},
        "health": {"type": "integer", "minimum": 1, "maximum": 90},
        "request": {"type": "integer", "minimum": 1, "maximum": 5},
        "command": {"type": "integer", "minimum": 1, "maximum": 45},
        "cleanup": {"type": "integer", "minimum": 1, "maximum": 60}
      }
    },
    "oracle_complete": {"const": false}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
